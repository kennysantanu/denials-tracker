# Denials Tracker environment — see README.md for full deployment instructions.
# Run ./install.ps1 (Windows) or ./install.sh (Linux/macOS) to generate this file automatically.

# ── App (required for both deployment modes) ──────────────────────────────────

PUBLIC_SUPABASE_URL=http://localhost:8000
PUBLIC_SUPABASE_ANON_KEY=replace-me-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-key

# postgres://user:password@host:port/db  (cloud: db.<ref>.supabase.co)
DATABASE_URL=postgres://postgres:replace-me-postgres-password@db:5432/postgres

ORIGIN=http://localhost:3000
HOST_PORT=3000
BODY_SIZE_LIMIT=50M

SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
PASSWORD_EXPIRY_DAYS=90

# AUTH_COOKIE_SECURE=false   # override cookie security (e.g. self-signed TLS)

# ── Bundled Supabase (only needed with docker-compose.supabase.yml) ───────────

# SSR docker-network override — set automatically by the install script.
SUPABASE_INTERNAL_URL=http://kong:8000

POSTGRES_PASSWORD=replace-me-postgres-password
POSTGRES_PORT=5432
POSTGRES_DB=postgres

JWT_SECRET=replace-me-with-a-random-32+-char-secret
JWT_EXPIRY=3600

PG_META_CRYPTO_KEY=replace-me-32-char-random-string

DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=replace-me-strong-password
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=54323

DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# Optional SMTP — leave blank for autoconfirm-only deployments.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Denials Tracker
