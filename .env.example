# Supabase
PUBLIC_SUPABASE_URL=http://localhost:8000
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# SvelteKit — must match the public URL users type in their browser (including port if non-standard).
ORIGIN=http://localhost:3000
HOST_PORT=3000

# Optional: force cookie security on/off regardless of ORIGIN protocol.
# Only needed in unusual setups (e.g. self-signed TLS cert in local dev).
# AUTH_COOKIE_SECURE=false

# HIPAA Session & Security
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
PASSWORD_EXPIRY_DAYS=90
